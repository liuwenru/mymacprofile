# A small, single-file tmux configuration.
# Target: tmux 3.8 on macOS; plugins are managed by TPM.

# -----------------------------------------------------------------------------
# General
# -----------------------------------------------------------------------------

# Keep the broadly available terminfo name used by the previous setup.
set -g default-terminal "screen-256color"
set -s focus-events on
set -s escape-time 50
set -g repeat-time 300
set -g history-limit 10000000
set -g display-time 0
set -g allow-passthrough on
# 明确告知 iterm2 等终端支持复制粘贴板
set -as terminal-features ',xterm*:clipboard'
# mosh 1.4 only accepts the OSC 52 "c" clipboard selector. Pin Ms to that
# selector so tmux copy-mode works consistently over both SSH and mosh.
set -as terminal-overrides ',xterm*:Ms=\E]52;c;%p2%s\7'
set -g set-clipboard on

# C-j is the only prefix.
unbind C-b
set -g prefix C-j
bind C-j send-prefix

# Start numbering at 1 and close numbering gaps automatically.
set -g base-index 1
setw -g pane-base-index 1
set -g renumber-windows on

# Window names show the pane directory and current command.
setw -g automatic-rename on
setw -g automatic-rename-format '#{b:pane_current_path}:#{b:pane_current_command}'
set -g set-titles on
set -g set-titles-string '#h: #S:#I.#P #W'

# Reload this one file with prefix + r. Prefix + Ctrl-u is also bound below.
unbind r
bind r source-file ~/.tmux.conf \; display-message '~/.tmux.conf reloaded'

# -----------------------------------------------------------------------------
# Windows and panes
# -----------------------------------------------------------------------------

# A new window uses the shell's default directory, matching the old setting.
bind c new-window

# New panes retain the current pane's directory.
unbind '"'
unbind %
bind | split-window -h -c '#{pane_current_path}'
bind - split-window -v -c '#{pane_current_path}'

# Vim-style pane navigation.
bind -r h select-pane -L
bind -r j select-pane -D
bind -r k select-pane -U
bind -r l select-pane -R

# Repeated pane resizing.
bind -r H resize-pane -L 5
bind -r J resize-pane -D 5
bind -r K resize-pane -U 5
bind -r L resize-pane -R 5

# Swap and zoom panes. Native zoom replaces Oh My Tmux's custom shell function.
bind '>' swap-pane -D
bind '<' swap-pane -U
bind + resize-pane -Z

# Session helpers retained from Oh My Tmux.
bind C-c new-session
bind C-f command-prompt -p 'find session:' 'switch-client -t "%%"'

# Clear both the terminal and tmux scrollback.
bind -n C-l send-keys C-l \; run-shell 'sleep 0.1' \; clear-history

# -----------------------------------------------------------------------------
# Mouse and copy mode
# -----------------------------------------------------------------------------

set -g mouse on
setw -g mode-keys vi

# prefix + m: temporarily let the outer terminal (for example SecureCRT)
# handle mouse selection, then press it again to restore tmux mouse support.
bind m if-shell -F '#{mouse}' {
  set -g mouse off
  display-message 'tmux mouse: off (terminal selection mode)'
} {
  set -g mouse on
  display-message 'tmux mouse: on'
}

# Let tmux forward copied text to the outer terminal through OSC 52. This also
# works when tmux is running on a remote host over SSH.
bind -T copy-mode-vi v send-keys -X begin-selection
bind -T copy-mode-vi y send-keys -X copy-selection-and-cancel
bind -T copy-mode-vi Enter send-keys -X copy-selection-and-cancel
bind -T copy-mode-vi MouseDragEnd1Pane send-keys -X copy-selection-and-cancel

# Start a native tmux selection in copy mode, while forwarding normal drag
# events to TUIs such as opencode when they have enabled mouse reporting.
bind -T copy-mode-vi MouseDrag1Pane select-pane \; send-keys -X begin-selection
bind -T root MouseDrag1Pane if-shell -F '#{||:#{pane_in_mode},#{mouse_any_flag}}' { send-keys -M } { copy-mode -M }

# -----------------------------------------------------------------------------
# Plugins
# -----------------------------------------------------------------------------

set -g @plugin 'tmux-plugins/tpm'
set -g @plugin 'tmux-plugins/tmux-sensible'
set -g @plugin 'tmux-plugins/tmux-resurrect'
set -g @plugin 'tmux-plugins/tmux-continuum'
set -g @plugin 'nhdaly/tmux-better-mouse-mode'

set -g @plugin 'momo-lab/tmux-toggle-scratch'
# 配置打开窗口的大小
set -g @toggle-scratch-popup-options '-w80% -h80%'
# 配置开启和关闭的快捷指令
set -g @toggle-scratch-keys 'C-l'

# Restore the last explicitly saved resurrect snapshot on tmux startup.
set -g @continuum-restore 'on'
set -g @continuum-save-interval '0'
set -g @scroll-down-exit-copy-mode 'on'

# Theme: Dracula, kept separate from behavior and key bindings.
set -g @plugin 'dracula/tmux'

# A compact, local-only status line: current directory and time.
# Network, weather and public-IP widgets are intentionally not enabled.
set -g @dracula-plugins 'cwd time'
set -g @dracula-show-left-icon '#S'
set -g @dracula-show-powerline true
set -g @dracula-show-flags true
set -g @dracula-border-contrast true
set -g @dracula-refresh-rate 5
set -g @dracula-show-timezone false
set -g @dracula-military-time true
set -g @dracula-time-format '%Y-%m-%d %H:%M'

# Initialize TPM before final user key overrides.
run '~/.tmux/plugins/tpm/tpm'

# Reload this configuration with prefix + Ctrl-u.
unbind C-u
bind C-u source-file ~/.tmux.conf \; display-message '~/.tmux.conf reloaded'

# Keep clipboard bindings last. Emit a c-selector OSC 52 sequence through the
# active pane so tmux serializes it with normal terminal output. Writing to
# client_tty directly can interleave the sequence with redraws over tssh.
bind -T copy-mode-vi y send-keys -X copy-pipe-and-cancel "base64 | tr -d '\r\n' | { printf '\033]52;c;'; cat; printf '\a'; } > '#{pane_tty}'"
bind -T copy-mode-vi Enter send-keys -X copy-pipe-and-cancel "base64 | tr -d '\r\n' | { printf '\033]52;c;'; cat; printf '\a'; } > '#{pane_tty}'"
bind -T copy-mode-vi MouseDragEnd1Pane send-keys -X copy-pipe-and-cancel "base64 | tr -d '\r\n' | { printf '\033]52;c;'; cat; printf '\a'; } > '#{pane_tty}'"
