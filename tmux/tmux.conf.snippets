# 远程工作主机用的 tmux 简化配置，直接复制粘贴到 ~/.tmux.conf 即可。
# 不依赖插件和额外文件；分段顺序与 tmux.conf 保持一致，便于对比合并。
#
# 版本兼容：远程主机上 tmux 2.8、3.1、3.8 都有，需要新版本的配置用 %if 包起来，低版本直接跳过。
# - 判断用 #{version}（正在运行的 server 版本），不用 tmux -V（PATH 里的 tmux 可能是另一个版本）。
# - 用 m: 通配匹配，因为 2.8 还没有 >= 等比较运算；模式只覆盖 3.x，出现 4.x 时需要调整。
# - %if 后面的条件不能加引号：2.8 不会去掉引号，"0" 也会被当成真。
# - 2.8 不认识 {} 块，块内每行会被当成顶层命令执行，所以含 {} 的配置必须放进 %if；
#   条件为假时 2.8 在解析前就整行跳过，不会碰到 {}。
# 用到的模式：3.0+ 3.*、3.2+ 3.[2-9]*、3.3+ 3.[3-9]*、3.5+ 3.[5-9]*、3.6+ 3.[6-9]*、3.7+ 3.[7-9]*、3.8+ 3.[8-9]*

# -----------------------------------------------------------------------------
# General 通用设置
# -----------------------------------------------------------------------------
%if #{m:3.[3-9]*,#{version}}
set -g cursor-colour red  # 红色光标（3.3+）
%endif
# 把终端获得/失去焦点的事件传给面板内程序（vim/neovim 的 autoread 等依赖它）。
set -s focus-events on
# 按下 Esc 后等待 50ms 判断是否为组合键；值太大会让 vim 中退出插入模式变慢。
set -s escape-time 50
# 带 -r 的绑定在按下前缀后 300ms 内可连续重复按，无需再次按前缀。
set -g repeat-time 300
# 每个面板保留的滚动历史行数（1000 万行，面板输出多时注意内存占用）。
set -g history-limit 100000
# display-message 消息的显示时长，0 表示一直显示到下一次按键。
set -g display-time 0
# 允许面板内程序通过 passthrough 直接给外层终端发送转义序列（图片协议、OSC 52 等，3.3+）。
%if #{m:3.[3-9]*,#{version}}
set -g allow-passthrough on
%endif
# 告诉 tmux：xterm 兼容的外层终端支持 OSC 52 剪贴板（terminal-features 3.2+）。
%if #{m:3.[2-9]*,#{version}}
set -as terminal-features ',xterm*:clipboard'
%endif
# 3.7 及以上使用 tmux 原生 OSC 52 剪贴板支持，更低版本关闭剪贴板集成。
%if #{m:3.[7-9]*,#{version}}
set -s set-clipboard on
%else
set -s set-clipboard off
%endif

# 前缀键：Ctrl-j 或 Ctrl-b
set -g prefix C-j
set -g prefix2 C-b

# 窗口和面板从 1 开始编号（贴合键盘数字键顺序），关闭窗口后自动重新编号补齐空缺。
set -g base-index 1
set -g pane-base-index 1
set -g renumber-windows on

# 窗口名自动显示为 "当前目录:当前命令"。
set -g automatic-rename on
set -g aggressive-resize on
set -g automatic-rename-format '#{=6:#{b:pane_current_path}}#{?#{==:#{b:pane_current_path},#{=6:#{b:pane_current_path}}},,...}:#{b:pane_current_command}'
# 同步设置外层终端的窗口/标签标题，格式："主机名: 会话:窗口.面板 窗口名"。
set -g set-titles on
set -g set-titles-string '#h: #S:#I.#P #W'

# 自动配置 session 名称；跳过 *@scratch，否则它被改名后 new-session -A 找不到，每次都新建一个
# （t/f 自定义时间格式 3.2+）
%if #{m:3.[2-9]*,#{version}}
set-hook -g session-created {
  if-shell -F '#{?#{m:*@scratch,#{session_name}},,1}' {
    rename-session "#{host_short}-#{t/f/%m%d-%H%M%S:session_created}"
  }
}
%endif
# 如果过长则只显示 40 个字符长度（带省略号的截断 3.0+）
# 按下前缀键后、下一个键按下之前，会话名变成黄底深色字加粗，作为前缀已生效的提醒；
# #[] 里的多个属性用空格分隔，不能用逗号，否则会被 #{?...} 当成分支分隔符。
%if #{m:3.*,#{version}}
set -g status-left '#{?client_prefix,#[bg=#EBCB8B fg=#303030 bold],}[#{=/40/…:session_name}]#[default]=> '
%endif

# 前缀 + r：重新加载本配置文件（前缀 + Ctrl-u / u 在文件末尾也有绑定）。
unbind r
bind r source-file ~/.tmux.conf \; display-message '~/.tmux.conf reloaded'

# -----------------------------------------------------------------------------
# Windows and panes 窗口与面板
# -----------------------------------------------------------------------------

# 前缀 + c：新建窗口，使用 shell 默认目录（通常是 $HOME），与旧配置行为一致；
# 如需继承当前目录，可追加 -c '#{pane_current_path}'。
bind c new-window

# 前缀 + | 左右分屏，前缀 + - 上下分屏，新面板继承当前面板所在目录；
# 同时解除默认的 " 和 % 分屏键。
unbind '"'
unbind %
bind | split-window -h -c '#{pane_current_path}'
bind - split-window -v -c '#{pane_current_path}'

# 前缀 + h/j/k：vim 风格切换面板（左/下/上），可连续按。
bind -r h select-pane -L
bind -r j select-pane -D
bind -r k select-pane -U
# 解除默认的 前缀 + o（切换到下一个面板）。
unbind o
# 前缀 + q：显示面板编号并一直停留（默认 1 秒后消失），按数字跳到对应面板，
# 按 Esc、q 或其他任意键退出。
bind q display-panes -d 0
# 前缀 + g：进入浮动面板的移动键表（tmux 3.8 默认键），这里加一条状态栏提示，
# 提示会停留到按下一个键为止；表内其余的键沿用 tmux 默认绑定。（浮动面板 3.8+）
# 移动键表内：h/j/k/l 把浮动面板向左/下/上/右移动，每次 3 格；
# H/L 变窄/变宽、K/J 变矮/变高（左上角不动，移动的是右边框和下边框）。
# 每条末尾再次进入移动键表，所以可以一直连按，按 Esc 等表内没有的键退出。
%if #{m:3.[8-9]*,#{version}}
bind g switch-client -T move \; display-message 'pane move: hjkl move | HJKL resize | 1-4 corner | arrows edge | 0 fill | , menu | other key exit'
bind -T move h move-pane -L 3 \; switch-client -T move
bind -T move j move-pane -D 3 \; switch-client -T move
bind -T move k move-pane -U 3 \; switch-client -T move
bind -T move l move-pane -R 3 \; switch-client -T move
bind -T move H resize-pane -R -3 \; switch-client -T move
bind -T move J resize-pane -D 3 \; switch-client -T move
bind -T move K resize-pane -D -3 \; switch-client -T move
bind -T move L resize-pane -R 3 \; switch-client -T move
%endif

# 前缀 + H/J/K/L：调整面板大小，每次 5 格，可连续按。
bind -r H resize-pane -L 5
bind -r J resize-pane -D 5
bind -r K resize-pane -U 5
bind -r L resize-pane -R 5

# 前缀 + > / <：与下一个/上一个面板交换位置；
# 前缀 + +：最大化/还原当前面板（tmux 原生 zoom，替代 Oh My Tmux 的自定义脚本）。
bind '>' swap-pane -D
bind '<' swap-pane -U
bind + resize-pane -Z

# 前缀 + Alt-1..7：在 tmux 默认布局键上增加"再按一次切到同组另一个布局"：
# Alt-1/Alt-2 一组（even-horizontal / even-vertical），
# Alt-3/Alt-6 一组（main-horizontal / 镜像），Alt-4/Alt-7 一组（main-vertical / 镜像）。
# 做法：先记下当前布局再套用本键布局，布局没有变化说明已经是它，改套同组另一个；
# 不记录"上次按了哪个键"，手动调整过面板大小后第一次按仍是套用本键布局。
# 窗口只有一个面板时先自动分出一个（继承当前目录）再套用布局，否则布局键看不出效果。
# （set -F 3.0+；镜像布局 3.5+，更低版本保持 tmux 默认布局键）
# 主面板占 65%：Alt-4 左大右小、Alt-3 上大下小（镜像布局则是右大、下大）；
# tmux 默认主面板固定 80 列 / 24 行，在大窗口里反而是小的那一边。（百分比 3.2+）
%if #{m:3.[2-9]*,#{version}}
set -gw main-pane-width 65%
set -gw main-pane-height 65%
%endif
# Mac 终端未开启 "Option 当 Meta 键" 时，Option-1..7 发出的是字符 ¡™£¢∞§¶（美式键盘布局），
# 所以每个布局按字符再绑一份，行为与 Alt-1..7 相同；∞ 对应 tmux 默认的 Alt-5（tiled）。
%if #{m:3.*,#{version}}
bind M-1 set -wF @layout_before '#{window_layout}' \; if-shell -F '#{==:#{window_panes},1}' 'split-window -c "#{pane_current_path}"' \; select-layout even-horizontal \; if-shell -F '#{==:#{@layout_before},#{window_layout}}' 'select-layout even-vertical'
bind M-2 set -wF @layout_before '#{window_layout}' \; if-shell -F '#{==:#{window_panes},1}' 'split-window -c "#{pane_current_path}"' \; select-layout even-vertical \; if-shell -F '#{==:#{@layout_before},#{window_layout}}' 'select-layout even-horizontal'
bind ¡ set -wF @layout_before '#{window_layout}' \; if-shell -F '#{==:#{window_panes},1}' 'split-window -c "#{pane_current_path}"' \; select-layout even-horizontal \; if-shell -F '#{==:#{@layout_before},#{window_layout}}' 'select-layout even-vertical'
bind ™ set -wF @layout_before '#{window_layout}' \; if-shell -F '#{==:#{window_panes},1}' 'split-window -c "#{pane_current_path}"' \; select-layout even-vertical \; if-shell -F '#{==:#{@layout_before},#{window_layout}}' 'select-layout even-horizontal'
bind ∞ select-layout tiled
%endif
%if #{m:3.[5-9]*,#{version}}
bind M-3 set -wF @layout_before '#{window_layout}' \; if-shell -F '#{==:#{window_panes},1}' 'split-window -c "#{pane_current_path}"' \; select-layout main-horizontal \; if-shell -F '#{==:#{@layout_before},#{window_layout}}' 'select-layout main-horizontal-mirrored'
bind M-6 set -wF @layout_before '#{window_layout}' \; if-shell -F '#{==:#{window_panes},1}' 'split-window -c "#{pane_current_path}"' \; select-layout main-horizontal-mirrored \; if-shell -F '#{==:#{@layout_before},#{window_layout}}' 'select-layout main-horizontal'
bind M-4 set -wF @layout_before '#{window_layout}' \; if-shell -F '#{==:#{window_panes},1}' 'split-window -c "#{pane_current_path}"' \; select-layout main-vertical \; if-shell -F '#{==:#{@layout_before},#{window_layout}}' 'select-layout main-vertical-mirrored'
bind M-7 set -wF @layout_before '#{window_layout}' \; if-shell -F '#{==:#{window_panes},1}' 'split-window -c "#{pane_current_path}"' \; select-layout main-vertical-mirrored \; if-shell -F '#{==:#{@layout_before},#{window_layout}}' 'select-layout main-vertical'
bind £ set -wF @layout_before '#{window_layout}' \; if-shell -F '#{==:#{window_panes},1}' 'split-window -c "#{pane_current_path}"' \; select-layout main-horizontal \; if-shell -F '#{==:#{@layout_before},#{window_layout}}' 'select-layout main-horizontal-mirrored'
bind § set -wF @layout_before '#{window_layout}' \; if-shell -F '#{==:#{window_panes},1}' 'split-window -c "#{pane_current_path}"' \; select-layout main-horizontal-mirrored \; if-shell -F '#{==:#{@layout_before},#{window_layout}}' 'select-layout main-horizontal'
bind ¢ set -wF @layout_before '#{window_layout}' \; if-shell -F '#{==:#{window_panes},1}' 'split-window -c "#{pane_current_path}"' \; select-layout main-vertical \; if-shell -F '#{==:#{@layout_before},#{window_layout}}' 'select-layout main-vertical-mirrored'
bind ¶ set -wF @layout_before '#{window_layout}' \; if-shell -F '#{==:#{window_panes},1}' 'split-window -c "#{pane_current_path}"' \; select-layout main-vertical-mirrored \; if-shell -F '#{==:#{@layout_before},#{window_layout}}' 'select-layout main-vertical'
%endif

# 会话辅助键（沿用 Oh My Tmux 习惯）：
# 前缀 + Ctrl-c 新建会话；前缀 + Ctrl-f 输入会话名查找并切换。
bind C-c new-session
bind C-f command-prompt -p 'find session:' 'switch-client -t "%%"'

# Ctrl-l（无需前缀）：先让 shell 清屏，等 0.1 秒后再清空 tmux 的滚动历史。
# 注意与下方 scratch 插件的 "前缀 + Ctrl-l" 是两个不同的键。
bind -n C-l send-keys C-l \; run-shell 'sleep 0.1' \; clear-history

# -----------------------------------------------------------------------------
# Mouse and copy mode 鼠标与复制模式
# -----------------------------------------------------------------------------

# 开启鼠标支持（点击切换面板、拖动调整大小、滚轮翻历史）；复制模式使用 vi 按键。
set -g mouse on
setw -g mode-keys vi

# 前缀 + m：临时关闭 tmux 鼠标，交给外层终端（如 SecureCRT）做本地选择复制；
# 再按一次恢复 tmux 鼠标支持。（{} 块 3.0+）
%if #{m:3.*,#{version}}
bind m if-shell -F '#{mouse}' {
  set -g mouse off
  display-message 'tmux mouse: off (terminal selection mode)'
} {
  set -g mouse on
  display-message 'tmux mouse: on'
}
%endif

# vi 复制模式：v 开始选择，y、Enter 或松开鼠标复制并退出复制模式。
# 复制内容通过 OSC 52 转发给外层终端，SSH 到远程主机上运行 tmux 时同样有效。
bind -T copy-mode-vi v send-keys -X begin-selection
bind -T copy-mode-vi y send-keys -X copy-selection-and-cancel
bind -T copy-mode-vi Enter send-keys -X copy-selection-and-cancel
bind -T copy-mode-vi MouseDragEnd1Pane send-keys -X copy-selection-and-cancel
bind -T copy-mode MouseDragEnd1Pane send-keys -X copy-selection-and-cancel

# 鼠标拖选：复制模式中直接开始 tmux 原生选择；
# 普通状态下拖动进入复制模式，但如果面板内程序（如 opencode、vim）开启了鼠标上报，
# 则把拖动事件原样交给该程序处理。（root 这条用了 {} 块，3.0+）
bind -T copy-mode-vi MouseDrag1Pane select-pane \; send-keys -X begin-selection
bind -T copy-mode MouseDrag1Pane select-pane \; send-keys -X begin-selection
%if #{m:3.*,#{version}}
bind -T root MouseDrag1Pane if-shell -F '#{||:#{pane_in_mode},#{mouse_any_flag}}' { send-keys -M } { copy-mode -M }
%endif

# -----------------------------------------------------------------------------
# Scratch, status line and colors 弹窗、状态栏与颜色（无插件）
# -----------------------------------------------------------------------------

# 前缀 + Ctrl-l：打开当前窗口专属的 scratch 弹窗，会话名形如 host-1102-220938-@3@scratch；
# 用 window_id 而不是窗口编号，renumber-windows 重排后仍对应同一个窗口。
# display-popup 不展开命令里的 #{}，原样交给内层 tmux 后会在新客户端上下文里展开成空，
# 所有窗口都变成同一个 -@scratch；因此用 run-shell -C 先在当前窗口上下文展开再执行。
# 注意 run-shell -C 只展开字符串参数，写成 { } 块不会展开。
# 工作目录由 popup 的 -d 决定，new-session 不带 -c 时沿用客户端所在目录。
# 在 scratch 内再次按下，只分离客户端，保留会话。
# 整个 scratch 段需要 3.3+（display-popup -T、popup-style；run-shell -C 3.2+）。
%if #{m:3.[3-9]*,#{version}}
bind C-l if-shell -F '#{m:*@scratch,#{session_name}}' {
  detach-client
} {
  run-shell -C 'display-popup -E -T scratch -w 80% -h 80% -d "#{pane_current_path}" "env -u TMUX tmux new-session -A -s #{session_name}-#{window_id}@scratch"'
}
# 窗口关闭（含整个会话关闭）时一并清理它的 scratch 会话；
# hook_window 是被关闭窗口的 window_id。父会话名必须用 hook_session_name，
# 此时窗口已解绑，session_name 会解析成其他会话。
# 用 run-shell 一步完成：if-shell 分支里的 tmux 命令拿不到 hook 上下文，kill 不掉。
# 没有对应 scratch（或在 scratch 内 exit）时 kill 失败，|| true 避免报错提示。
set-hook -g window-unlinked {
  run-shell 'tmux kill-session -t "=#{hook_session_name}-#{hook_window}@scratch" 2>/dev/null || true'
}
# scratch 弹窗使用终端默认颜色
set -gw popup-style "bg=default,fg=default"
set -gw popup-border-style "bg=default,fg=default"
%endif

# 状态栏

# 状态栏：深灰背景、柔白文字，当前窗口亮白加粗
set -g status-style 'bg=#303030,fg=#D8DEE9'
setw -g window-status-current-style 'bg=#505050,fg=#FFFFFF,bold'
# 用竖线和两侧空格分隔底栏标签
setw -g window-status-separator '│'

# 显式保留当前窗口的 list=focus，窗口列表超宽时跟随当前窗口滚动。
# loop_last_flag 需要 3.6+，更低版本使用默认 status-format。
%if #{m:3.[6-9]*,#{version}}
set -g status-format[0] '#[align=left range=left]#{E:status-left}#[norange list=on]#[list=left-marker]<#[list=right-marker]>#[list=on]#{W:#[range=window|#{window_index} bg=#303030 fg=#D8DEE9 nobold list=on]#I:#W#F#{?loop_last_flag,, │ },#[range=window|#{window_index} bg=#505050 fg=#FFFFFF bold list=focus]#I:#W#F#[bg=#303030 fg=#D8DEE9 nobold]#{?loop_last_flag,, │ }}#[norange nolist align=right bg=#303030 fg=#D8DEE9 nobold]#{E:status-right}'
%endif

set -g status-left-length 45
set -g status-right " %H:%M:%S %Y-%m-%d"
setw -g monitor-activity on
set -g status-interval 1
set -g status-justify left

# 前缀 + F8：切换颜色模式，并重连当前客户端（terminal-features 3.2+）。
# 重连优先用 /usr/local/bin/tmux（自装的静态版），不存在时退回 PATH 里的 tmux；
# 不用 $ 变量，因为本文件会经 Alfred 的未加引号 heredoc 粘贴，$ 会被 shell 展开。
%if #{m:3.[2-9]*,#{version}}
bind F8 {
  if-shell -F '#{==:#{@color_mode},rgb}' {
    set -sF 'terminal-features[99]' '#{client_termname}:RGB@:256'
    set -sF 'terminal-overrides[99]' '#{client_termname}:colors=256:RGB@:Tc@:setrgbf@:setrgbb@'
    set -g @color_mode '256'
  } {
    if-shell -F '#{==:#{@color_mode},256}' {
      set -sF 'terminal-features[99]' '#{client_termname}:RGB@:256@'
      set -sF 'terminal-overrides[99]' '#{client_termname}:colors=16:RGB@:Tc@:setrgbf@:setrgbb@'
      set -g @color_mode 'ansi'
    } {
      set -sF 'terminal-features[99]' '#{client_termname}:256:RGB'
      set -sF 'terminal-overrides[99]' '#{client_termname}:colors=256'
      set -g @color_mode 'rgb'
    }
  }
  run-shell "if [ -x /usr/local/bin/tmux ]; then exec /usr/local/bin/tmux detach-client -t #{q:client_name} -E 'exec env -u TMUX /usr/local/bin/tmux -S #{q:socket_path} attach-session -t #{q:session_id}'; else exec tmux detach-client -t #{q:client_name} -E 'exec env -u TMUX tmux -S #{q:socket_path} attach-session -t #{q:session_id}'; fi"
}
%endif

# 重载配置：前缀 + u
# 前缀 + Ctrl-u 或 前缀 + u：重新加载本配置文件。
unbind C-u
bind C-u source-file ~/.tmux.conf \; display-message '~/.tmux.conf reloaded'
unbind u
bind u source-file ~/.tmux.conf \; display-message '~/.tmux.conf reloaded'
